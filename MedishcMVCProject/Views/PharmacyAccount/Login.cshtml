@model LoginVM

@{
    Layout = null;
}
@addTagHelper *, Microsoft.AspNetCore.Mvc.TagHelpers

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8">
    <title>Login</title>
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <link rel="shortcut icon" href="~/admin/images/favicon.svg">
    <link rel="stylesheet" href="~/admin/fonts/remix/remixicon.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/admin/css/main.min.css" asp-append-version="true" />

    <style>
        .full-height-center {
            min-height: 100vh;
            display: flex;
            align-items: center;
            justify-content: center;
        }
    </style>
</head>
<body class="login-bg">

    <div class="container full-height-center">
        <div class="auth-box w-100" style="max-width: 500px;">
            <form asp-action="Login" asp-controller="PharmacyAccount" method="post">
                <div class="text-center mb-4">
                    <a asp-controller="Home" asp-action="Index" class="auth-logo">
                        <img src="~/admin/images/logo-dark.svg" alt="Logo" style="max-width: 150px;" />
                    </a>
                </div>

                <h4 class="mb-4 text-center">Login</h4>

                <div class="text-danger mb-3" asp-validation-summary="ModelOnly"></div>

                <div class="mb-3">
                    <label asp-for="UserNameOrEmail" class="form-label">UserName Or Email</label>
                    <input asp-for="UserNameOrEmail" class="form-control" placeholder="Enter UserName Or Email" />
                    <span asp-validation-for="UserNameOrEmail" class="text-danger"></span>
                </div>
                <div class="mb-3">
                    <label asp-for="Password" class="form-label"></label>
                    <input asp-for="Password" class="form-control" placeholder="Enter password" />
                    <span asp-validation-for="Password" class="text-danger"></span>
                </div>
                <div class="col-md-6">
                    <label asp-for="IsPersistent">Remember Me</label>
                    <input asp-for="IsPersistent" />

                </div>
                <div class="mb-3 d-grid gap-2">
                    <button type="submit" class="btn btn-primary">Signup</button>
                    <a asp-area="Admin" asp-controller="Account" asp-action="Register" class="btn btn-secondary">Not Registered? Signup</a>
                </div>
            </form>
        </div>
    </div>

    <!-- Optional: Validation Scripts -->
    <script src="https://cdnjs.cloudflare.com/ajax/libs/jquery/3.7.1/jquery.min.js"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/jquery-validate/1.19.5/jquery.validate.min.js"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/jquery-validation-unobtrusive/3.2.13/jquery.validate.unobtrusive.min.js"></script>

</body>
</html>