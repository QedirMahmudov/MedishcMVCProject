@using MedishcMVCProject.DAL
@using Microsoft.Extensions.Options
@inject IOptions<StripeSettings> Stripe

<section class="page-title bg-overlay bg-overlay-dark bg-parallax" id="page-title">
    <div class="bg-section"><img src="/assets/images/page-titles/1.jpg" alt="Background" /></div>
    <div class="container">
        <div class="row">
            <div class="col-12 col-lg-6 offset-lg-3">
                <div class="title">
                    <div class="title-heading">
                        <h1>Ödəniş</h1>
                    </div>
                    <ol class="breadcrumb">
                        <li class="breadcrumb-item"><a href="index.html">Ana Səhifə</a></li>
                        <li class="breadcrumb-item active" aria-current="page">Ödəniş</li>
                    </ol>
                </div>
            </div>
        </div>
    </div>
</section>

<section class="shop shop-checkout bg-white" id="shop-checkout">
    <div class="container">
        <div class="row">
            <div class="col-12">
                <p class="cart-coupon">Endirim kuponu var? <a href="#">Buraya klikləyin</a></p>
            </div>
        </div>
        <form class="checkoutForm mb-0" method="post" id="checkoutForm">
            @Html.AntiForgeryToken()
            <div class="row">
                <div class="col-12 col-lg-6">
                    <div class="checkout-widget">
                        <div class="widget-title">
                            <h5>Xəstə Məlumatları</h5>
                        </div>
                        <div class="checkout-body">
                            <div class="row">
                                <div class="col-12">
                                    <label>Ad<span class="required">*</span></label>
                                    <input class="form-control" type="text" name="firstName" required="" />
                                </div>
                                <div class="col-12">
                                    <label>Soyad<span class="required">*</span></label>
                                    <input class="form-control" type="text" name="lastName" required="" />
                                </div>
                                <div class="col-12">
                                    <label>Ünvan<span class="required">*</span></label>
                                    <input class="form-control" type="text" name="address" placeholder="Ev ünvanınız" required="" />
                                </div>
                                <div class="col-12">
                                    <label>Şəhər<span class="required">*</span></label>
                                    <input class="form-control" type="text" name="city" required="" />
                                </div>
                                <div class="col-12">
                                    <label>Ölkə<span class="required">*</span></label>
                                    <input class="form-control" type="text" name="country" required="" />
                                </div>
                                <div class="col-12">
                                    <label>Poçt kodu<span class="required">*</span></label>
                                    <input class="form-control" type="text" name="postcode" required="" />
                                </div>
                                <div class="col-12">
                                    <label>Telefon<span class="required">*</span></label>
                                    <input class="form-control" type="tel" name="phone" required="" />
                                </div>
                                <div class="col-12">
                                    <label>Email<span class="required">*</span></label>
                                    <input class="form-control" type="email" name="email" required="" />
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
                <div class="col-12 col-lg-6">
                    <div class="checkout-widget">
                        <div class="widget-title">
                            <h5>Əlavə Məlumatlar</h5>
                        </div>
                        <div class="checkout-body">
                            <div class="row">
                                <div class="col-12">
                                    <label>Randevu Qeydləri (İstəyə görə)</label>
                                    <textarea class="form-control" name="orderNotes" cols="30" rows="3" placeholder="Randevu ilə bağlı xüsusi qeydlər"></textarea>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </form>

        <div class="row">
            <div class="col-12">
                <div class="your-order">
                    <h5>Sizin Sifarişiniz</h5>
                    <div class="table-order">
                        <table>
                            <thead>
                                <tr class="order-heading">
                                    <th>Məhsul</th>
                                    <th>Miqdar</th>
                                    <th>Qiymət</th>
                                </tr>
                            </thead>
                            <tbody id="cart-items">
                                <!-- Cart items will be loaded here -->
                            </tbody>
                            <tfoot>
                                <tr class="cart-subtotal">
                                    <td colspan="2">Ara məbləğ</td>
                                    <td id="subtotal">$0.00</td>
                                </tr>
                                <tr class="cart-total">
                                    <td colspan="2"><strong>Cəmi</strong></td>
                                    <td id="total"><strong>$0.00</strong></td>
                                </tr>
                            </tfoot>
                        </table>
                    </div>
                </div>
            </div>
        </div>

        <div class="row">
            <div class="col-12">
                <div class="payment">
                    <div class="payment-method">
                        <div class="alert alert-info">
                            <i class="fa fa-info-circle"></i>
                            Ödəniş Stripe vasitəsi ilə təhlükəsiz şəkildə həyata keçirilir.
                        </div>
                    </div>
                    <hr />
                    <div class="payment-conditions">
                        <p class="message">Şəxsi məlumatlarınız sifarişi emal etmək, bu veb saytda təcrübənizi dəstəkləmək və <a href="#">məxfilik siyasəti</a>mizdə təsvir olunan digər məqsədlər üçün istifadə olunacaq.</p>
                        <div class="row no-gutters">
                            <div class="col-12 mb-3">
                                <input type="checkbox" id="terms-checkbox" required />
                                <label for="terms-checkbox"> Veb saytın <a href="#" target="_blank">Şərtlər və Qaydalarını</a> oxudum və razıyam <span class="required">*</span></label>
                            </div>
                            <div class="col-12">
                                <button id="checkout-button" class="btn btn--primary" type="button" disabled>
                                    <i class="fa fa-credit-card"></i> Ödəniş et
                                </button>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>

@section Scripts {
    <script src="https://js.stripe.com/v3/"></script>
    <script>
        var stripe = Stripe("@Stripe.Value.Publishablekey");

        // Load cart data on page load
        $(document).ready(function() {
            loadCartData();
        });

        // Load cart data from server or localStorage
        function loadCartData() {
            $.ajax({
                url: '@Url.Action("GetCartData", "Shop")',
                type: 'GET',
                success: function(data) {
                    displayCartItems(data);
                },
                error: function() {
                    console.log('Could not load cart data from server');
                    loadFromLocalStorage();
                }
            });
        }

        // Load from localStorage (fallback)
        function loadFromLocalStorage() {
            const cart = JSON.parse(localStorage.getItem('cart') || '[]');
            displayCartItems({ items: cart });
        }

        // Display cart items in table
        function displayCartItems(cartData) {
            const cartItemsContainer = $('#cart-items');
            cartItemsContainer.empty();

            let subtotal = 0;

            if (cartData.items && cartData.items.length > 0) {
                cartData.items.forEach(function(item) {
                    const itemTotal = item.price * item.quantity;
                    subtotal += itemTotal;

                    const row = `
                        <tr class="cart-product">
                            <td class="product-name">${item.name}</td>
                            <td>${item.quantity}</td>
                            <td>$${itemTotal.toFixed(2)}</td>
                        </tr>
                    `;
                    cartItemsContainer.append(row);
                });
            } else {
                cartItemsContainer.append(`
                    <tr>
                        <td colspan="3" class="text-center">Səbət boşdur</td>
                    </tr>
                `);
            }

            // Update totals
            $('#subtotal').text('$' + subtotal.toFixed(2));
            $('#total').text('$' + subtotal.toFixed(2));

            // Enable/disable checkout button based on cart content
            const checkoutBtn = $('#checkout-button');
            if (subtotal > 0) {
                checkoutBtn.removeClass('disabled');
            } else {
                checkoutBtn.addClass('disabled');
                checkoutBtn.attr('disabled', true);
            }
        }

        // Terms checkbox handler
        document.getElementById('terms-checkbox').addEventListener('change', function() {
            const checkoutBtn = document.getElementById('checkout-button');
            const hasItems = parseFloat($('#subtotal').text().replace('$', '')) > 0;
            checkoutBtn.disabled = !this.checked || !hasItems;
        });

        // Checkout button handler
        document.getElementById('checkout-button').addEventListener('click', function () {
            const form = document.getElementById('checkoutForm');

            // Form validation
            if (!form.checkValidity()) {
                form.reportValidity();
                return;
            }

            // Disable button and show loading
            this.disabled = true;
            this.innerHTML = '<i class="fa fa-spinner fa-spin"></i> İşlənir...';

            // Collect form data
            const formData = new FormData(form);
            const data = Object.fromEntries(formData.entries());

            // Create checkout session
            fetch('@Url.Action("CreateCheckoutSession", "Shop")', {
                method: 'POST',
                headers: {
                    'Content-Type': 'application/json',
                    'RequestVerificationToken': $('input[name="__RequestVerificationToken"]').val()
                },
                body: JSON.stringify(data)
            })
            .then(function (response) {
                if (!response.ok) {
                    return response.text().then(text => {
                        throw new Error(`HTTP ${response.status}: ${text}`);
                    });
                }
                return response.json();
            })
            .then(function (session) {
                return stripe.redirectToCheckout({ sessionId: session.id });
            })
            .then(function (result) {
                if (result.error) {
                    alert(result.error.message);
                    resetCheckoutButton();
                }
            })
            .catch(function (error) {
                console.error("Error:", error);
                alert("Xəta baş verdi: " + error.message);
                resetCheckoutButton();
            });
        });

        // Reset checkout button state
        function resetCheckoutButton() {
            const btn = document.getElementById('checkout-button');
            btn.disabled = !document.getElementById('terms-checkbox').checked;
            btn.innerHTML = '<i class="fa fa-credit-card"></i> Ödəniş et';
        }

        // Prevent form submission
        document.getElementById('checkoutForm').addEventListener('submit', function(e) {
            e.preventDefault();
            document.getElementById('checkout-button').click();
        });
    </script>
}