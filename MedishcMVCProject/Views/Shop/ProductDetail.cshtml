@model ProductDetailVM

<section class="page-title page-title-blank bg-white" id="page-title">
    <div class="container">
        <div class="row">
            <div class="col-12 col-lg-6">
                <div class="title">
                    <ol class="breadcrumb breadcrumb-long">
                        <li class="breadcrumb-item"><a href="/">Home</a></li>
                        <li class="breadcrumb-item"><a href="/shop">shop</a></li>
                        <li class="breadcrumb-item active" aria-current="page">@Model.Product.Name</li>
                    </ol>
                </div>
            </div>
        </div>
    </div>
</section>

<section class="single-product" id="single-product">
    <div class="container">
        <div class="row">
            <!-- Product Image -->
            <div class="col-12 col-lg-6">
                <div class="product-img">
                    <img class="img-fluid" src="/assets/images/shop/full/@Model.Product.ImageUrl" alt="@Model.Product.Name" />
                </div>
            </div>

            <!-- Product Info -->
            <div class="col-12 col-lg-6">
                <div class="product-content">
                    <div class="product-title">
                        <h3>@Model.Product.Name</h3>
                    </div>

                    <div class="product-price">
                        <span>$@Model.Product.Price</span>
                    </div>

                    <div class="product-desc">
                        <p>@Model.Product.Description</p>
                    </div>

                    <div class="product-action" data-id="@Model.Product.Id" data-price="@Model.Product.Price">
                        <form asp-controller="Shop" asp-action="AddToCart" method="post" class="d-flex align-items-center gap-3">
                            <input type="hidden" name="productId" value="@Model.Product.Id" />
                            <button type="submit" class="btn btn--secondary btn-radius-right">add to cart</button>
                        </form>
                    </div>
                    <div class="product-details mt-4">
                        <table class="table">
                            <tbody>
                                <tr>
                                    <td class="name">SKU:</td>
                                    <td class="value">@Model.Product.SKU</td>
                                </tr>
                                <tr>
                                    <td class="name">category:</td>
                                    <td class="value">@Model.Product.Category?.Name</td>
                                </tr>
                                <tr>
                                    <td class="name">tags:</td>
                                    <td class="value">
                                        @for (int i = 0; i < Model.Product.ProductTags.Count; i++)
                                        {
                                            var tagName = Model.Product.ProductTags[i].Tag?.Name;
                                            if (!string.IsNullOrEmpty(tagName))
                                            {
                                                <span>@tagName</span>
                                                @if (i < Model.Product.ProductTags.Count - 1)
                                                {
                                                    <span>, </span>
                                                }
                                            }
                                        }
                                    </td>
                                </tr>
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>

<section class="shop shop-2">
    <div class="container">
        <div class="row">
            <div class="col-12">
                <h5>related products</h5>
            </div>
        </div>
        <div class="row">
            @foreach (var item in Model.RelatedProducts)
            {
                <div class="col-12 col-md-6 col-lg-3">
                    <div class="product-item" data-hover="">
                        <div class="product-img">
                            <a asp-action="ProductDetail" asp-route-id="@item.Id">
                                <img src="/assets/images/shop/full/@item.ImageUrl" alt="@item.Name" />
                            </a>
                            <a class="add-to-cart" href="#"><i class="fas fa-shopping-cart"></i> add to cart</a>
                        </div>
                        <div class="product-content">
                            <div class="product-title">
                                <a asp-controller="Shop" asp-action="ProductDetail" asp-route-id="@item.Id">@item.Name</a>
                            </div>
                            <div class="product-price"><span>$@item.Price</span></div>
                        </div>
                    </div>
                </div>
            }
        </div>
    </div>
</section>

@section Scripts {
    <script>
        $(document).ready(function () {
            $.ajaxSetup({
                beforeSend: function (xhr, settings) {
                    if (settings.type === 'POST') {
                        xhr.setRequestHeader("RequestVerificationToken", $('input[name="__RequestVerificationToken"]').val());
                    }
                }
            });

            function updateTotals() {
                let subtotal = 0;

                $('.cart-product').each(function () {
                    const quantity = parseInt($(this).find('.pro-qunt').val()) || 0;
                    const price = parseFloat($(this).data('price')) || 0;
                    const total = quantity * price;

                    $(this).find('.cart-product-total').text('$' + total.toFixed(2));
                    subtotal += total;
                });

                $('#subtotal-amount').text('$' + subtotal.toFixed(2));
                $('#total-amount').text('$' + subtotal.toFixed(2));
            }

            function updateCartOnServer(productId, quantity, $row) {
                $.ajax({
                    url: '@Url.Action("UpdateCartQuantity", "Shop")',
                    type: 'POST',
                    data: {
                        productId: productId,
                        quantity: quantity
                    },
                    success: function (response) {
                        if (response.success) {
                            const price = parseFloat($row.data('price')) || 0;
                            const total = price * quantity;

                            $row.find('.pro-qunt').val(quantity);
                            $row.find('.cart-product-total').text('$' + total.toFixed(2));

                            updateTotals();
                        } else {
                            alert('Xəta: ' + response.message);
                        }
                    },
                    error: function () {
                        alert('Server xətası!');
                    }
                });
            }

            function removeFromCart(productId, $row) {
                $.ajax({
                    url: '@Url.Action("RemoveFromCart", "Shop")',
                    type: 'POST',
                    data: {
                        id: productId
                    },
                    success: function (response) {
                        if (response.success) {
                            $row.fadeOut(300, function () {
                                $(this).remove();
                                updateTotals();

                                if ($('.cart-product').length === 0) {
                                    location.reload();
                                }
                            });
                        } else {
                            alert('Silinmədi: ' + response.message);
                        }
                    },
                    error: function () {
                        alert('Silərkən xəta baş verdi!');
                    }
                });
            }

            $('.plus').on('click', function (e) {
                e.preventDefault();

                const $input = $(this).closest('.product-quantity').find('.pro-qunt');
                const $row = $(this).closest('.cart-product');
                const productId = $row.data('id');
                let quantity = parseInt($input.val()) || 0;
                const max = parseInt($input.data('max')) || 10;

                if (quantity < max) {
                    quantity += 1;
                    updateCartOnServer(productId, quantity, $row);
                }
            });

            $('.minus').on('click', function (e) {
                e.preventDefault();

                const $input = $(this).closest('.product-quantity').find('.pro-qunt');
                const $row = $(this).closest('.cart-product');
                const productId = $row.data('id');
                let quantity = parseInt($input.val()) || 0;
                const min = parseInt($input.data('min')) || 1;

                if (quantity > min) {
                    quantity -= 1;
                    updateCartOnServer(productId, quantity, $row);
                }
            });

            $('.cart-product-remove img').on('click', function (e) {
                e.preventDefault();

                const $row = $(this).closest('.cart-product');
                const productId = $row.data('id');

                if (confirm('Bu məhsulu silmək istəyirsiniz?')) {
                    removeFromCart(productId, $row);
                }
            });

            $('#update-cart-btn').on('click', function (e) {
                e.preventDefault();

                const cartData = [];
                $('.cart-product').each(function () {
                    const productId = $(this).data('id');
                    const quantity = parseInt($(this).find('.pro-qunt').val()) || 0;

                    cartData.push({
                        productId: productId,
                        quantity: quantity
                    });
                });

                $.ajax({
                    url: '@Url.Action("UpdateCart", "Shop")',
                    type: 'POST',
                    data: JSON.stringify(cartData),
                    contentType: 'application/json',
                    success: function (response) {
                        if (response.success) {
                            updateTotals();
                            alert('Səbət uğurla yeniləndi!');
                        } else {
                            alert('Yenilənmədi: ' + response.message);
                        }
                    },
                    error: function () {
                        alert('Yeniləmə zamanı xəta baş verdi!');
                    }
                });
            });

            updateTotals();
        });
    </script>
}
}
