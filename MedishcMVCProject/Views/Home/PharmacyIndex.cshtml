<!--
============================
Blog #3 Section
============================
-->
<section class="blog blog-grid blog-grid-4" id="blog-3">
    <div class="container">
        <div class="row">
            <div class="col-12 col-lg-6 offset-lg-3">
                <div class="heading heading-7 text-center">
                    <p class="heading-subtitle">health essentials</p>
                    <h2 class="heading-title">recent articles</h2>
                </div>
            </div>
        </div>
        <!-- End .row-->
        <div class="carousel owl-carousel carousel-dots" data-slide="3" data-slide-rs="2" data-autoplay="true" data-nav="false" data-dots="true" data-space="30" data-loop="true" data-speed="200">
            @foreach (var item in Model.Blogs)
            {
                <div class="item">
                    <div class="blog-entry" data-hover="">
                        <div class="entry-img">
                            <div class="entry-date">
                                <div class="entry-content">
                                    <span class="day">@item.CreatedAt.Day</span>
                                    <span class="month">@item.CreatedAt.ToString("MMMM")</span>
                                    <span class="year">@item.CreatedAt.Year</span>
                                </div>
                            </div>
                            <a asp-controller="Blog" asp-action="BlogDetail" asp-route-id="@item.Id">
                                <img src="~/assets/images/blog/grid/@item.Image" alt="@item.Title" />
                            </a>
                        </div>
                        <div class="entry-content">
                            <div class="entry-meta">
                                <div class="entry-category">
                                    @if (item.BlogCategories != null)
                                    {
                                        foreach (var category in item.BlogCategories)
                                        {
                                            <a href="javascript:void(0)">@category.Category.Name</a>
                                        }
                                    }
                                </div>
                                <div class="divider"></div>
                                <div class="entry-author">
                                    <p>@item.Author.Name</p>
                                </div>
                            </div>
                            <div class="entry-title">
                                <h4>
                                    <a asp-controller="Blog" asp-action="BlogDetail" asp-route-id="@item.Id">@item.Title</a>
                                </h4>
                            </div>
                            <div class="entry-bio">
                                <p>@(item.Description.Length > 150 ? item.Description.Substring(0, 150) + "..." : item.Description)</p>
                            </div>
                            <div class="entry-more">
                                <a class="btn btn--white btn-line btn-line-before btn-line-inversed" asp-controller="Blog" asp-action="BlogDetail" asp-route-id="@item.Id">
                                    <div class="line"><span></span></div><span>read more</span>
                                </a>
                            </div>
                        </div>
                    </div>
                </div>
            }
        </div>
        <!-- End .carousel-->
    </div>
</section>