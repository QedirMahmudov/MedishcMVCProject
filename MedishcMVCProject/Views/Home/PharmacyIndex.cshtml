                                <div class="slide-action"><a class="btn btn--white btn-line btn-line-after btn-line-inversed" asp-controller="AboutUs" asp-action="AboutUs"> <span>more about us</span><span class="line"> <span></span></span></a><a class="btn btn--primary btn-line btn-line-after" asp-controller="Shop" asp-action="Index"> <span>shop now</span><span class="line"> <span></span></span></a></div>
                            </div>
                            <!-- End .slide-content -->
                        </div>
                    </div>
                    <!--  End .row-->
                </div>
            </div>
            <!-- End .slide-->
            <!--  Start .slide-->
            <div class="slide bg-overlay bg-overlay-dark-slider">
                <div class="bg-section"><img src="~/assets/images/sliders/11.jpg" alt="Background" /></div>
                <div class="container">
                    <div class="row">
                        <div class="col-12 col-lg-8 offset-lg-2">
                            <div class="slide-content align-items-center text-center">
                                <h1 class="slide-headline">your first medical choice</h1>
                                <p class="slide-desc">The health and well-being of our patients and their health care team will always be our priority, so we follow the best practices.</p>
                                <div class="slide-action"><a class="btn btn--white btn-line btn-line-after btn-line-inversed" asp-controller="AboutUs" asp-action="AboutUs"> <span>more about us</span><span class="line"> <span></span></span></a><a class="btn btn--primary btn-line btn-line-after" asp-controller="Shop" asp-action="Index"> <span>shop now</span><span class="line"> <span></span></span></a></div>
                            </div>
                            <!-- End .slide-content -->
                        </div>
                    </div>
                    <!--  End .row-->
                </div>
            </div>
            <!-- End .slide-->
        </div>
        <!-- End .slider-carousel-->
    </div>
    <!--  End .container-fluid-->
</section>
<!--
============================
Shop Section
============================
-->
<section class="shop shop-3" id="shop-1">
    <div class="container">
        <div class="row">
            <div class="col-sm-12 col-md-12 col-lg-6 offset-lg-3">
                <div class="heading heading-7 text--center">
                    <p class="heading-subtitle">Low Priced Medical Supplies</p>
                    <h2 class="heading-title">The Largest Selections Of Medical Products</h2>
                </div>
            </div>
        </div>
        <div class="row">
            @foreach (var product in Model.Products)
            {
                <div class="col-12 col-md-6 col-lg-4">
                    <div class="product-item" data-hover="">
                        <div class="product-img">
                            <a asp-action="ProductDetail" asp-route-id="@product.Id">
                                <img src="/assets/images/shop/grid/@product.ImageUrl" alt="@product.Name" />
                            </a>
                            <form asp-action="AddToCart" asp-controller="Shop" method="post" class="add-to-cart-form">
                                <input type="hidden" name="productId" value="@product.Id" />
                                <button type="submit" class="add-to-cart btn btn-sm btn-primary">
                                    <i class="fas fa-shopping-cart"></i> Add to Cart
                                </button>
                            </form>
                        </div>
                        <div class="product-content">
                            <div class="product-title">
                                <a asp-action="ProductDetail" asp-route-id="@product.Id">@product.Name</a>
                            </div>
                            <div class="product-price"><span>$@product.Price</span></div>
                        </div>
                    </div>
                </div>
            }
        </div>
        <!-- End .row-->
    </div>
    <!-- End .container-->
</section>
