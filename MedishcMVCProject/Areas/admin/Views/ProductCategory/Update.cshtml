@using MedishcMVCProject.ViewModels.ProductVM
@model ProductCategoryVM
@{
    int i = 0;
}
<div class="app-body">
    <div class="row gx-3">
        <div class="col-xl-12">
            <div class="card">
                <div class="card-body">
                    <h4 class="card-title">Update Category</h4>
                    <p class="card-description">Category update form</p>

                    <form asp-action="Update" method="post" enctype="multipart/form-data" class="forms-sample">
                        <div class="row gx-3">
                            <div class="col-xxl-3 col-lg-4 col-sm-6">
                                <div class="mb-3">
                                    <label class="form-label" asp-for="CategoryName">CategoryName <span class="text-danger">*</span></label>
                                    <input asp-for="CategoryName" type="text" class="form-control" placeholder="Enter Category Name" />
                                    <span class="text-danger" asp-validation-for="CategoryName"></span>
                                </div>
                            </div>
                        </div>
                        <div class="d-flex gap-2 justify-content-end mt-4">
                            <a asp-action="List" class="btn btn-light">Cancel</a>
                            <button type="submit" class="btn btn-primary me-2">Submit</button>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
