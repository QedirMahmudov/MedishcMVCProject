@model UpdateSpecialistVM
@{
    int i = 0;
}
<div class="app-body">
    <!-- Row starts -->
    <div class="row gx-3">
        <div class="col-xl-12">
            <div class="card">
                <div class="card-body">
                    <h4 class="card-title">Update Specialist</h4>
                    <p class="card-description">Specialist Update</p>

                    <!-- Form starts here -->
                    <form method="post" enctype="multipart/form-data" class="forms-sample">

                        <!-- Custom tabs starts -->
                        <div class="custom-tabs-container">

                            <!-- Nav tabs starts -->
                            <ul class="nav nav-tabs" id="customTab2" role="tablist">
                            </ul>
                            <!-- Nav tabs ends -->
                            <!-- Tab content starts -->
                            <div class="tab-content h-350">
                                <div class="tab-pane fade show active" id="oneA" role="tabpanel">
                                    <!-- Row starts -->
                                    <div class="row gx-3">
                                        <div class="col-xxl-3 col-lg-4 col-sm-6">
                                            <div class="mb-3">
                                                <label class="form-label" asp-for="DepartmentName">Department Name<span class="text-danger">*</span></label>
                                                <div class="input-group">
                                                    <span class="input-group-text">
                                                        <i class="ri-account-circle-line"></i>
                                                    </span>
                                                    <input asp-for="DepartmentName" type="text" class="form-control" placeholder="Enter Department Name">
                                                </div>
                                                <span class="text-danger" asp-validation-for="DepartmentName"></span>
                                            </div>
                                        </div>
                                        <div class="col-xxl-3 col-lg-4 col-sm-6">
                                            <div class="mb-3">
                                                <label class="form-label" asp-for="HeadDoctorFullName">HeadDoctor FullName <span class="text-danger">*</span></label>
                                                <div class="input-group">
                                                    <span class="input-group-text">
                                                        <i class="ri-account-circle-line"></i>
                                                    </span>
                                                    <input asp-for="HeadDoctorFullName" type="text" class="form-control" placeholder="Enter HeadDoctor FullName">
                                                </div>
                                                <span class="text-danger" asp-validation-for="HeadDoctorFullName"></span>
                                            </div>
                                        </div>
                                        <div class="col-xxl-3 col-lg-4 col-sm-6">
                                            <div class="mb-3">
                                                <label class="form-label" asp-for="DepartmentEmail">Email <span class="text-danger">*</span></label>
                                                <div class="input-group">
                                                    <span class="input-group-text">
                                                        <i class="ri-mail-open-line"></i>
                                                    </span>
                                                    <input asp-for="DepartmentEmail" type="email" class="form-control" placeholder="Enter Email">
                                                </div>
                                                <span class="text-danger" asp-validation-for="DepartmentEmail"></span>
                                            </div>
                                        </div>
                                        <div class="col-xxl-3 col-lg-4 col-sm-6">
                                            <div class="mb-3">
                                                <label class="form-label" asp-for="DepartmentPhoneNumber">Department PhoneNumber<span class="text-danger">*</span></label>
                                                <div class="input-group">
                                                    <span class="input-group-text">
                                                        <i class="ri-phone-line"></i>
                                                    </span>
                                                    <input asp-for="DepartmentPhoneNumber" type="text" class="form-control" placeholder="Enter Department PhoneNumber">
                                                </div>
                                                <span class="text-danger" asp-validation-for="DepartmentPhoneNumber"></span>
                                            </div>
                                        </div>
                                    </div>
                                    <!-- Row ends -->
                                </div>
                            </div>
                        </div>
                        <!-- Custom tabs ends -->
                        <!-- Card acrions starts -->
                        <div class="d-flex gap-2 justify-content-end mt-4">
                            <button class="btn btn-light">Cancel</button>
                            <button type="submit" class="btn btn-primary me-2">Submit</button>
                        </div>
                        <!-- Card acrions ends -->
                    </form>
                </div>
            </div>
        </div>
    </div>
    <!-- Row ends -->

</div>