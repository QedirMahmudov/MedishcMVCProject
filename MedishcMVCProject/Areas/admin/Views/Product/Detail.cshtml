@model GetProductVM

<div class="card">
    <div class="card-body">
        <div class="d-flex gap-4 align-items-start">
            <img src="/assets/images/shop/full/@Model.Image" alt="@Model.Name" class="rounded border shadow" style="width: 200px; height: auto;" />

            <div>
                <h3 class="mb-3">@Model.Name</h3>

                <p><strong>SKU:</strong> @Model.SKU</p>
                <p><strong>Category:</strong> @Model.CategoryName</p>
                <p><strong>Specialist:</strong> @Model.SpecialistName</p>
                <p><strong>Price:</strong> @Model.Price.ToString("0.00") ₼</p>
                <p><strong>Description:</strong> @Model.Description</p>

                <div class="mt-3">
                    <a asp-action="Update" asp-route-id="@Model.Id" class="btn btn-outline-success">Edit</a>
                    <a asp-action="List" class="btn btn-outline-secondary">Back to List</a>
                </div>
            </div>
        </div>
    </div>
</div>