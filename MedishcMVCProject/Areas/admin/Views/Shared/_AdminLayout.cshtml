@using MedishcMVCProject.DAL
@using Microsoft.AspNetCore.Identity
@using Microsoft.EntityFrameworkCore
@inject UserManager<AppUser> UserManager
@inject SignInManager<AppUser> SignInManager
@inject AppDbContext _context

@{
    AppUser currentUser = null;
    string initials = "JB";
    string fullName = "Guest";
    string role = "User";
    string doctorImagePath = "/assets/images/staff/378796c1-9e17-4046-b358-839d00cef34c.jpg";

    if (SignInManager.IsSignedIn(User))
    {
        currentUser = await UserManager.GetUserAsync(User);

        if (currentUser != null)
        {
            var name = currentUser.Name ?? "";
            var surname = currentUser.Surname ?? "";

            initials = $"{(name.Length > 0 ? name[0] : 'N')}{(surname.Length > 0 ? surname[0] : 'S')}";
            fullName = $"{name} {surname}".Trim();

            var roles = await UserManager.GetRolesAsync(currentUser);
            role = roles.FirstOrDefault() ?? "User";

            var doctor = await _context.Doctors
                .FirstOrDefaultAsync(d => d.AppUserId == currentUser.Id);

            if (doctor?.Image != null)
            {
                doctorImagePath = $"/assets/images/team/full/{doctor.Image}";
            }
        }
    }
}


